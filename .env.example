# Copy to .env and adjust. Every value here has a safe local default in settings.py.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=*
# Postgres in production (SQLite is used when unset)
# DATABASE_URL=postgres://eduflow:password@localhost:5432/eduflow

# --- Supabase (Postgres + Storage) ------------------------------------------------------------
# 1. New project, region South Asia (Mumbai). Keep the database password.
# 2. Connect -> Connection string -> Session pooler (IPv4) or Direct (IPv6 only). Paste the URI below.
# 3. Storage -> New bucket "eduflow-media", Public OFF.
# 4. Storage -> Settings -> S3 Connection: endpoint + region; "New access key" for the key pair.
# 5. Project Settings -> Data API: switch it off (or un-expose "public"). Django enforces tenancy,
#    so its tables must never be reachable through Supabase's REST API.
# Then: manage.py ensure_schema && manage.py migrate && manage.py seed_design --reset
# (manage.py upload_media copies an existing local media/ folder into the bucket.)
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
# DATABASE_SCHEMA=eduflow
# SUPABASE_S3_ENDPOINT=https://<ref>.storage.supabase.co/storage/v1/s3
# SUPABASE_S3_REGION=ap-south-1
# SUPABASE_S3_BUCKET=eduflow-media
# SUPABASE_S3_ACCESS_KEY_ID=
# SUPABASE_S3_SECRET_ACCESS_KEY=
# Development only: return the sign-in code in the API response
OTP_DEV_ECHO=1

# Realtime (Centrifugo). Leave REALTIME_API_URL empty to use HTTP polling only.
# The two values below are DEVELOPMENT-ONLY and match centrifugo/config.dev.json.
# Generate new ones for any shared or production server.
REALTIME_API_URL=http://127.0.0.1:8001
REALTIME_API_KEY=jIZ1Aqm2zs8l8pYpKX2RPy8qoJ3cMVqgN777ekOMyCI
REALTIME_TOKEN_SECRET=zloHn356ImBBJ1tTNgr9p_h1WUj5MiIWiCSaS8vMj3rrkY94svcwcNnfb0pKHMBZ
# Phones don't need your PC's IP here: the app swaps 127.0.0.1 for the API's host.
REALTIME_WS_URL=ws://127.0.0.1:8001/connection/websocket

# Push notifications through Expo (FCM/APNs). Needs an EAS project and a device build.
EXPO_PUSH_ENABLED=0
EXPO_ACCESS_TOKEN=
# GPS devices via Traccar JSON forwarding (sent in the X-Ingest-Secret header)
TRACCAR_SHARED_SECRET=change-me
# Background tasks backend (immediate for dev; a queue-backed backend in production)
# TASKS_BACKEND=django.tasks.backends.immediate.ImmediateBackend

# Where people open the web app. Used in credential slips and invite links from the platform admin (/platform).
# WEB_URL=https://app.example.com
