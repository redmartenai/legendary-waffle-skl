# Copy to .env and adjust. Every value here has a safe local default in settings.py.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=*
# Postgres in production (SQLite is used when unset)
# DATABASE_URL=postgres://eduflow:password@localhost:5432/eduflow
# Development only: return the sign-in code in the API response
OTP_DEV_ECHO=1

# Realtime (Centrifugo). Leave REALTIME_API_URL empty to use HTTP polling only.
# The two values below are DEVELOPMENT-ONLY and match centrifugo/config.dev.json.
# Generate new ones for any shared or production server.
REALTIME_API_URL=http://127.0.0.1:8001
REALTIME_API_KEY=jIZ1Aqm2zs8l8pYpKX2RPy8qoJ3cMVqgN777ekOMyCI
REALTIME_TOKEN_SECRET=zloHn356ImBBJ1tTNgr9p_h1WUj5MiIWiCSaS8vMj3rrkY94svcwcNnfb0pKHMBZ
# Phones don't need your PC's IP here: the app swaps 127.0.0.1 for the API's host.
REALTIME_WS_URL=ws://127.0.0.1:8001/connection/websocket

# Push notifications through Expo (FCM/APNs). Needs an EAS project and a device build.
EXPO_PUSH_ENABLED=0
EXPO_ACCESS_TOKEN=
# GPS devices via Traccar JSON forwarding (sent in the X-Ingest-Secret header)
TRACCAR_SHARED_SECRET=change-me
# Background tasks backend (immediate for dev; a queue-backed backend in production)
# TASKS_BACKEND=django.tasks.backends.immediate.ImmediateBackend
