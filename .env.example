# EduFlow local environment. Copy to `.env` (git-ignored) and change the values.
#   cp .env.example .env
#
# These values are for LOCAL DEVELOPMENT ONLY. Production values come from the deployment
# platform's secret store. Never put real secrets in this file or in git.
# Use only letters and digits in passwords here (they are embedded in URLs).

# ----------------------------------------------------------------------------- Django
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=dev-only-insecure-change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1],backend
API_DOCS_ENABLED=true
# Must stay false outside local development. Production refuses to start if true.
OTP_ECHO_DEV_CODE=false
LOG_LEVEL=INFO
# json | console
LOG_FORMAT=console

# ----------------------------------------------------------------------------- PostgreSQL
POSTGRES_DB=eduflow
POSTGRES_USER=eduflow
POSTGRES_PASSWORD=devonlypassword
POSTGRES_PORT=5432
# Used when running Django on the host (tests, manage.py). Containers get their own value from Compose.
DATABASE_URL=postgres://eduflow:devonlypassword@127.0.0.1:5432/eduflow

# ----------------------------------------------------------------------------- Redis / Celery
REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2

# ----------------------------------------------------------------------------- Object storage (S3-compatible)
STORAGE_PORT=9000
STORAGE_CONSOLE_PORT=9001
STORAGE_ENDPOINT_URL=http://127.0.0.1:9000
STORAGE_BUCKET=eduflow-private
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=eduflowdevaccess
STORAGE_SECRET_KEY=eduflowdevsecretkey

# ----------------------------------------------------------------------------- API exposure
# 127.0.0.1 keeps the API private to this machine. Set 0.0.0.0 to reach it from a phone on your Wi-Fi.
API_BIND=127.0.0.1
API_PORT=8000
