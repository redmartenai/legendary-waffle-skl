# EduFlow local environment. Copy to `.env` (git-ignored) and change the values.
#   cp .env.example .env
#
# These values are for LOCAL DEVELOPMENT ONLY. Production values come from the deployment
# platform's secret store. Never put real secrets in this file or in git.
# Use only letters and digits in passwords here (they are embedded in URLs).

# ----------------------------------------------------------------------------- Django
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=dev-only-insecure-change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1],backend
API_DOCS_ENABLED=true
# Must stay false outside local development. Production refuses to start if true.
OTP_ECHO_DEV_CODE=false
LOG_LEVEL=INFO
# json | console
LOG_FORMAT=console

# ----------------------------------------------------------------------------- Authentication (Phase 2)
# docs/security/authentication.md and docs/security/token-lifecycle.md. The defaults below are the
# production defaults; uncomment only to experiment locally.
# ACCESS_TOKEN_MINUTES=10
# REFRESH_TOKEN_DAYS=1
# REFRESH_TOKEN_REMEMBER_DAYS=30
# AUTH_SESSION_MAX_DAYS=90
# Optional separate key for access tokens (at least 50 random characters). Derived from DJANGO_SECRET_KEY if unset.
# JWT_SIGNING_KEY=
# How many reverse proxies in front of the API append X-Forwarded-For. 0 = ignore the header (local).
TRUSTED_PROXY_COUNT=0
# Set false only for local load experiments. Production refuses to start with it false.
RATE_LIMITS_ENABLED=true

# ----------------------------------------------------------------------------- OTP / SMS (Phase 2)
# docs/security/otp.md. Development default: codes are written to the backend log (ConsoleSmsProvider).
# Production must point at a real gateway adapter; it refuses the console and test providers.
# OTP_SMS_PROVIDER=eduflow.identity.otp.providers.ConsoleSmsProvider
# PHONE_DEFAULT_COUNTRY_CODE=91

# ----------------------------------------------------------------------------- Invitations and email (Phase 4)
# docs/security/invitations.md. Development prints invitation emails and SMS to the backend log.
# The secret is appended to this base: keep it after "#" so it never reaches server logs. Production: https.
INVITATION_LINK_BASE=http://localhost:8081/invite#token=
# INVITATION_TTL_HOURS=72
# INVITATION_RESEND_SECONDS=60
# Development default: django.core.mail.backends.console.EmailBackend. Production: SMTP or a provider backend
# (and EMAIL_HOST / EMAIL_HOST_USER / EMAIL_HOST_PASSWORD from the secret store). Unset = email disabled.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# DEFAULT_FROM_EMAIL=EduFlow <no-reply@school.example>

# ----------------------------------------------------------------------------- Row-Level Security (Phase 2)
# docs/security/rls.md. Requests and tasks switch to this database role so RLS applies. Keep the default.
# DATABASE_RLS_ROLE=eduflow_app

# ----------------------------------------------------------------------------- PostgreSQL
POSTGRES_DB=eduflow
POSTGRES_USER=eduflow
POSTGRES_PASSWORD=devonlypassword
POSTGRES_PORT=5432
# Used when running Django on the host (tests, manage.py). Containers get their own value from Compose.
DATABASE_URL=postgres://eduflow:devonlypassword@127.0.0.1:5432/eduflow

# ----------------------------------------------------------------------------- Redis / Celery
REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2

# ----------------------------------------------------------------------------- Object storage (S3-compatible)
STORAGE_PORT=9000
STORAGE_CONSOLE_PORT=9001
STORAGE_ENDPOINT_URL=http://127.0.0.1:9000
STORAGE_BUCKET=eduflow-private
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=eduflowdevaccess
STORAGE_SECRET_KEY=eduflowdevsecretkey

# ----------------------------------------------------------------------------- API exposure
# 127.0.0.1 keeps the API private to this machine. Set 0.0.0.0 to reach it from a phone on your Wi-Fi.
API_BIND=127.0.0.1
API_PORT=8000

# ----- White-label (ADR-029, docs/deployment/white-label.md)
# Schools are reachable at <code>.<base domain>; empty disables subdomains.
# WHITE_LABEL_BASE_DOMAIN=eduflow.app
# Hosts that show the platform's own branding (comma-separated).
# WHITE_LABEL_PLATFORM_HOSTS=app.eduflow.app
# Custom-domain ownership checks. Default: DisabledVerifier (the platform verifies by hand).
# DOMAIN_VERIFIER=eduflow.branding.verification.DnsOverHttpsVerifier
# DOMAIN_VERIFICATION_DOH_URL=https://cloudflare-dns.com/dns-query
# Platform branding used when a school has none.
# BRANDING_DEFAULT_NAME=EduFlow
# BRANDING_DEFAULT_PRIMARY_COLOR=#1E40AF
# BRANDING_DEFAULT_SECONDARY_COLOR=#0EA5E9

# ----- Monitoring and scheduled per-school jobs (ADR-031)
# How often the monitoring rules run for every school, in seconds (default 900).
# SCHOOL_JOBS_FREQUENT_SECONDS=900

# ----- AI question drafting (ADR-032). Empty: not configured, generation answers 503.
# EduFlow ships no provider; set a dotted path to a class with generate(subject, topic, count, grade).
# AI_QUESTION_PROVIDER=
